    "This removes the channel from your favorites. You can add it again by holding Select on it in What's On or the guide." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird der Sender aus deinen Favoriten entfernt. Zum erneuten Hinzufügen halte auf dem Sender in „Jetzt im TV“ oder im Programm die Auswahltaste gedrückt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί αυτό το κανάλι από τα αγαπημένα. Μπορείς να το προσθέσεις ξανά κρατώντας πατημένο το Επιλογή στο «Τι παίζει» ή στον οδηγό."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire la chaîne de vos favoris. Vous pourrez la rajouter en maintenant Sélectionner dessus dans En ce moment ou le guide."
          }
        }
      }
    },
    "This removes the playlist from your server. The titles stay in your library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird die Playlist von deinem Server entfernt. Die Titel bleiben in deiner Mediathek."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί τη λίστα αναπαραγωγής από τον διακομιστή. Οι τίτλοι μένουν στη βιβλιοθήκη."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire la playlist de votre serveur. Les titres restent dans votre bibliothèque."
          }
        }
      }
    },
    "This removes the row from Home. You can pin it again from the collection in its library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird die Reihe von der Startseite entfernt. Du kannst sie in ihrer Mediathek über die Sammlung wieder anpinnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί αυτή τη σειρά από την Αρχική. Μπορείς να την καρφιτσώσεις ξανά από τη συλλογή στη βιβλιοθήκη της."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire la rangée de l’Accueil. Vous pourrez l’épingler de nouveau depuis la collection dans sa bibliothèque."
