    },
    "Keeps your settings, servers and Live TV sources the same on every Apple TV, iPhone, iPad and Mac on your Apple Account. Sign-ins are encrypted in iCloud. Watch progress stays with your servers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält Einstellungen, Server und Live-TV-Quellen auf allen Geräten mit deinem Apple-Account gleich. Anmeldungen liegen verschlüsselt in iCloud, der Fortschritt auf deinen Servern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronise réglages, serveurs et sources TV en direct sur vos Apple TV, iPhone, iPad et Mac avec votre compte Apple. Connexions chiffrées dans iCloud. La progression reste sur les serveurs."
          }
        }
      }
    },
