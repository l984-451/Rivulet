        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός αυτού του χρήστη. Το Rivulet τον αποθηκεύει στην Κλειδοθήκη."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mot de passe de cet utilisateur, conservé dans le trousseau."
          }
        }
      }
    },
    "That was your %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war dein %lld"
