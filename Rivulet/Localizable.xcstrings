    },
    "Clear metadata cache and reload all library content from your Plex server. Images will be kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leert den Metadaten-Cache und lädt alle Mediatheksinhalte neu von deinem Plex-Server. Bilder bleiben erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Καθαρίζει την προσωρινή μνήμη μεταδεδομένων και φορτώνει ξανά τη βιβλιοθήκη από το Plex. Οι εικόνες διατηρούνται."
          }
        }
      }
    },
    "Click to show or hide this library in the sidebar and on Home. Press and hold to move it up or down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke, um diese Mediathek in der Seitenleiste und auf der Startseite ein- oder auszublenden. Halte gedrückt, um sie nach oben oder unten zu verschieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτησε για εμφάνιση ή απόκρυψη της βιβλιοθήκης στην πλαϊνή στήλη και στην Αρχική. Κράτησε πατημένο για μετακίνηση πάνω ή κάτω."
          }
        }
      }
    },
    "Click to show or hide this playlist on Home. Once it is shown, press and hold to move it up or down." : {

    },
    "Click to show or hide this row in the sidebar. Press and hold to move it up or down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke, um diese Zeile in der Seitenleiste ein- oder auszublenden. Halte gedrückt, um sie nach oben oder unten zu verschieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτησε για εμφάνιση ή απόκρυψη αυτής της σειράς στην πλαϊνή στήλη. Κράτησε πατημένο για μετακίνηση."
          }
        }
      }
    },
    "Click to show or hide this row on Home. Press and hold to move it up or down." : {

    },
