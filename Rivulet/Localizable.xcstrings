    "On a device signed in to Jellyfin, open Settings, choose Quick Connect and enter this code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf einem bei Jellyfin angemeldeten Gerät die Einstellungen, wähle „Quick Connect“ und gib diesen Code ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σε συσκευή συνδεδεμένη στο Jellyfin άνοιξε Ρυθμίσεις, επίλεξε «Γρήγορη σύνδεση» και πληκτρολόγησε αυτόν τον κωδικό."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
