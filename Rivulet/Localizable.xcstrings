          }
        }
      }
    },
    "Shows Recently Added and Recently Released rows in each library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt in jeder Mediathek die Reihen „Zuletzt hinzugefügt“ und „Zuletzt erschienen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εμφανίζει σειρές «Προστέθηκαν πρόσφατα» και «Κυκλοφόρησαν πρόσφατα» σε κάθε βιβλιοθήκη."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche Ajouts récents et Sorties récentes dans chaque bibliothèque."
          }
        }
      }
    },
    "Asks before closing multiview, so one press can't end every stream." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt nach, bevor die Mehrfachansicht geschlossen wird, damit ein Tastendruck nicht alle Streams beendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande confirmation avant de fermer la multivue."
          }
        }
      }
    },
    "Shows a banner of featured titles at the top of each library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt oben in jeder Mediathek ein Banner mit ausgewählten Titeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bannière de titres à l’honneur en haut de chaque bibliothèque."
          }
        }
      }
    },
    "Shows all Live TV sources together under one sidebar entry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt alle Live-TV-Quellen gemeinsam unter einem Eintrag in der Seitenleiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regroupe les sources TV en direct sous une entrée de la barre latérale."
          }
        }
      }
    },
    "Shows every remote press on screen, how long it was held and which remote sent it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt jeden Tastendruck der Fernbedienung auf dem Bildschirm, wie lange er gehalten wurde und welche Fernbedienung ihn gesendet hat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche chaque appui de la télécommande, sa durée et la télécommande qui l’a envoyé."
          }
        }
      }
    },
    "Shows the profile picker each time Rivulet opens, and when you come back after more than 30 seconds away: on the Home Screen, in another app or on the screensaver." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Profilauswahl bei jedem Start von Rivulet und wenn du nach über 30 Sekunden zurückkehrst: vom Home-Bildschirm, aus einer anderen App oder vom Bildschirmschoner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le sélecteur de profil à chaque ouverture de Rivulet et après plus de 30 secondes d’absence : écran d’accueil, autre app ou économiseur d’écran."
          }
        }
      }
    },
