    "How far a single Left press skips back during playback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit du während der Wiedergabe mit einem einzelnen Druck nach links zurückspringst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο πίσω μετακινεί ένα πάτημα Αριστερά κατά την αναπαραγωγή."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saut arrière à chaque appui sur Gauche pendant la lecture."
          }
        }
      }
    },
    "How far a single Right press skips ahead during playback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit du während der Wiedergabe mit einem einzelnen Druck nach rechts vorspringst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόσο μπροστά μετακινεί ένα πάτημα Δεξιά κατά την αναπαραγωγή."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saut avant à chaque appui sur Droite pendant la lecture."
          }
        }
      }
    },
    "How long each photo stays on screen during a slideshow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange jedes Foto in einer Diashow zu sehen ist."
          }
