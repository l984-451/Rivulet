      }
    },
    "Select to stop muting this word." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Wort aus, um es nicht mehr stummzuschalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επίλεξε για να σταματήσει η σίγαση αυτής της λέξης."
          }
        }
      }
    },
    "Select Your Servers" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Server auswählen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλογή διακομιστών"
          }
        }
      }
    },
    "Selecting a Continue Watching tile resumes it at once. Off opens the preview instead and turns off the Resume or Restart Prompt." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Kachel in „Weiter ansehen“ auswählst, wird sie sofort fortgesetzt. „Aus“ öffnet stattdessen die Vorschau und deaktiviert die Fortsetzen-Abfrage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή τίτλου στη «Συνέχεια παρακολούθησης» συνεχίζει αμέσως την αναπαραγωγή. Ανενεργό, ανοίγει την προεπισκόπηση και απενεργοποιεί την ερώτηση «Συνέχεια ή Επανεκκίνηση»."
          }
        }
      }
    },
    "Selecting a movie or show opens its full details at once, skipping the preview card. Off keeps the preview, where you can browse the row." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Film oder eine Serie auswählst, öffnen sich sofort alle Details, ohne die Vorschaukarte. „Aus“ behält die Vorschau, in der du die Reihe durchblättern kannst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιλογή ταινίας ή σειράς ανοίγει κατευθείαν τις πλήρεις λεπτομέρειες, παρακάμπτοντας την κάρτα προεπισκόπησης. Ανενεργό, διατηρεί την προεπισκόπηση για περιήγηση."
          }
        }
      }
    },
    "Send Diagnostics" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnose senden"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποστολή διαγνωστικών"
          }
        }
      }
    },
    "Sends a snapshot of Rivulet's setup and recent logs, and gives you a code to quote in a report. No titles, servers, addresses or passwords." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet eine Momentaufnahme der Einrichtung von Rivulet und der letzten Protokolle und gibt dir einen Code, den du in einer Meldung angeben kannst. Keine Titel, Server, Adressen oder Passwörter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στέλνει στιγμιότυπο των ρυθμίσεων και πρόσφατων αρχείων καταγραφής του Rivulet, με κωδικό αναφοράς. Δεν περιλαμβάνει τίτλους, διακομιστές, διευθύνσεις ή κωδικούς."
          }
        }
      }
    },
