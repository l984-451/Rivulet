      }
    },
    "Click to show or hide this library in the sidebar and on Home. Press and hold to move it up or down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke, um diese Mediathek in der Seitenleiste und auf der Startseite ein- oder auszublenden. Halte gedrückt, um sie nach oben oder unten zu verschieben."
          }
        }
      }
    },
    "Click to show or hide this row in the sidebar. Press and hold to move it up or down." : {
      "localizations" : {
        "de" : {
