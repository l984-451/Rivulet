      }
    },
    "The server address from your provider, with its port. You can also paste a get.php link: Rivulet fills in the username and password from it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serveradresse deines Anbieters mit Port. Du kannst auch einen get.php-Link einfügen: Rivulet übernimmt daraus Benutzername und Passwort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διεύθυνση και η θύρα του διακομιστή του παρόχου. Μπορείς να επικολλήσεις και σύνδεσμο get.php: το Rivulet συμπληρώνει τα στοιχεία σύνδεσης από αυτόν."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse du serveur de votre fournisseur, avec son port. Vous pouvez aussi coller un lien get.php : Rivulet en extrait le nom d’utilisateur et le mot de passe."
          }
        }
      }
    },
    "The server couldn't convert this item" : {
      "localizations" : {
