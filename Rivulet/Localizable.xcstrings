          }
        }
      }
    },
    "That code expired. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code ist abgelaufen. Versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός έληξε. Δοκίμασε ξανά."
          }
        }
      }
    },
    "That playlist URL doesn't look right. Check it and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Playlist-URL scheint nicht zu stimmen. Prüfe sie und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το URL λίστας δεν φαίνεται σωστό. Έλεγξέ το και δοκίμασε ξανά."
          }
        }
      }
    },
    "That server has no Dispatcharr sign-in. Clear the username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server hat keine Dispatcharr-Anmeldung. Lass Benutzername und Passwort leer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής δεν προσφέρει σύνδεση Dispatcharr. Διάγραψε όνομα χρήστη και κωδικό."
          }
        }
      }
    },
    "That server refused Rivulet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat Rivulet abgewiesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής απέρριψε το Rivulet."
          }
        }
      }
    },
    "That user's password. Rivulet keeps it in the Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Passwort dieses Benutzers. Rivulet speichert es im Schlüsselbund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός αυτού του χρήστη. Το Rivulet τον αποθηκεύει στην Κλειδοθήκη."
          }
        }
      }
    },
    "That was your %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war dein %lld"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό ήταν το %lld σου"
          }
        }
      }
    },
    "The %@ server you are signed in to." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der %@-Server, bei dem du angemeldet bist."
          }
        }
      }
    },
    "The %@ user you are signed in as." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der %@-Benutzer, als der du angemeldet bist."
          }
        }
      }
    },
    "The audio track to play when a title has several. Original keeps the file's main track. Picking a track in the player also changes this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Audiospur, die wiedergegeben wird, wenn ein Titel mehrere hat. „Original“ behält die Hauptspur der Datei. Wenn du im Player eine Spur auswählst, ändert sich auch diese Einstellung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το κομμάτι ήχου όταν ένας τίτλος έχει πολλά. Το «Αρχικό» κρατά το κύριο κομμάτι. Η επιλογή κομματιού στη συσκευή αναπαραγωγής αλλάζει επίσης αυτή τη ρύθμιση."
          }
        }
      }
    },
    "The download is too large." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download ist zu groß."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η λήψη είναι υπερβολικά μεγάλη."
          }
        }
      }
    },
    "The download was cut short" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download wurde abgebrochen"
          }
        },
        "el" : {
          "stringUnit" : {
