    },
    "Turn off to remove this server from Rivulet: its libraries, Home rows, Continue Watching and Live TV. Your account stays signed in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte diese Option aus, um diesen Server aus Rivulet zu entfernen: seine Mediatheken, Reihen der Startseite, „Weiter ansehen“ und Live-TV. Dein Account bleibt angemeldet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποίησε για αφαίρεση αυτού του διακομιστή από το Rivulet: βιβλιοθήκες, σειρές Αρχικής, Συνέχεια παρακολούθησης και ζωντανή τηλεόραση. Ο λογαριασμός παραμένει συνδεδεμένος."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez pour retirer ce serveur de Rivulet : bibliothèques, rangées d’Accueil, Reprendre la lecture et TV en direct. Votre compte reste connecté."
          }
        }
      }
    },
    "Turn on another server first, or sign out of Plex." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte zuerst einen anderen Server ein oder melde dich von Plex ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποίησε πρώτα άλλον διακομιστή ή αποσυνδέσου από το Plex."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez d’abord un autre serveur, ou déconnectez-vous de Plex."
          }
        }
      }
    },
    "Turns the content filter on, muting and skipping by the categories below. A player button pauses it for the current title." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet den Inhaltsfilter ein, der nach den Kategorien unten stummschaltet und überspringt. Mit einer Taste im Player pausierst du ihn für den aktuellen Titel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιεί το φίλτρο περιεχομένου για σίγαση και παράλειψη ανά κατηγορία. Ένα κουμπί στο πρόγραμμα αναπαραγωγής το παύει για τον τρέχοντα τίτλο."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active le filtre de contenu : masque et saute selon les catégories ci-dessous. Un bouton du lecteur le met en pause pour le titre en cours."
          }
        }
      }
    },
    "Tvheadend" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend"
          }
        }
      }
    },
    "Tvheadend didn't accept that username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend hat Benutzername und Passwort nicht akzeptiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Tvheadend δεν δέχτηκε αυτό το όνομα χρήστη και τον κωδικό."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend a refusé cet identifiant et ce mot de passe."
          }
        }
      }
    },
    "Tvheadend didn't give Rivulet a stream for this user. Check its streaming rights, or update Tvheadend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend hat Rivulet für diesen Benutzer keinen Stream geliefert. Prüfe seine Streaming-Rechte oder aktualisiere Tvheadend."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Tvheadend δεν έδωσε ροή στο Rivulet για αυτόν τον χρήστη. Έλεγξε δικαιώματα μετάδοσης ή ενημέρωσε το Tvheadend."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend n’a pas fourni de flux à Rivulet pour cet utilisateur. Vérifiez ses droits de streaming, ou mettez Tvheadend à jour."
          }
        }
      }
    },
    "Tvheadend refused this user. Check its password and rights in Tvheadend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend hat diesen Benutzer abgewiesen. Prüfe sein Passwort und seine Rechte in Tvheadend."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Tvheadend απέρριψε αυτόν τον χρήστη. Έλεγξε κωδικό και δικαιώματα στο Tvheadend."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend a refusé cet utilisateur. Vérifiez son mot de passe et ses droits dans Tvheadend."
          }
        }
      }
    },
    "Type a word or a short phrase to mute. Capitals and punctuation don't matter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ein Wort oder einen kurzen Ausdruck ein, der stummgeschaltet werden soll. Groß- und Kleinschreibung sowie Satzzeichen spielen keine Rolle."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πληκτρολόγησε λέξη ή σύντομη φράση για σίγαση. Κεφαλαία και σημεία στίξης δεν επηρεάζουν."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un mot ou une courte phrase à masquer. Majuscules et ponctuation sont ignorées."
          }
        }
      }
    },
