    "A channel profile shows only that profile's channels. The name is how this source appears in Live TV." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Senderprofil zeigt nur die Sender dieses Profils. Unter dem Namen erscheint diese Quelle in Live-TV."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα προφίλ καναλιών εμφανίζει μόνο τα δικά του κανάλια. Το όνομα καθορίζει πώς εμφανίζεται αυτή η πηγή στη ζωντανή τηλεόραση."
          }
        }
      }
    },
