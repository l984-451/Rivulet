    },
    "iCloud Sync" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Synchronisierung"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisation iCloud"
          }
        }
      }
    },
    "Keeps your settings, servers and Live TV sources the same on your Apple TV, iPhone and iPad. Sign-ins are stored encrypted in iCloud. Watch progress comes from your servers and is not part of this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält deine Einstellungen, Server und Live-TV-Quellen auf Apple TV, iPhone und iPad gleich. Anmeldungen liegen verschlüsselt in iCloud. Den Wiedergabefortschritt liefern deine Server, er gehört nicht dazu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronise vos réglages, serveurs et sources TV en direct sur votre Apple TV, iPhone et iPad. Les connexions sont stockées chiffrées dans iCloud. La progression de lecture vient de vos serveurs et n’en fait pas partie."
          }
        }
      }
    },
    "Sign in to iCloud in the Settings app to sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich in der Einstellungen-App bei iCloud an, um zu synchronisieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à iCloud dans l’app Réglages pour synchroniser."
          }
        }
      }
    },
