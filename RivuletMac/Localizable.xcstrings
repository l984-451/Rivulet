    "Countdown" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Countdown"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αντίστροφη μέτρηση"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte à rebours"
          }
        }
      }
    },
    "Countdown is how long Up Next waits before the next episode starts. Limit stops autoplay after that many episodes in a row." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Countdown bestimmt, wie lange „Als Nächstes“ wartet, bevor die nächste Folge startet. Das Limit stoppt die automatische Wiedergabe nach so vielen Folgen hintereinander."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αντίστροφη μέτρηση ορίζει πόσο περιμένει το «Επόμενο» πριν ξεκινήσει το επόμενο επεισόδιο. Το όριο σταματά την αυτόματη αναπαραγωγή μετά από τόσα συνεχόμενα επεισόδια."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compte à rebours est le temps d’attente de À suivre avant le démarrage de l’épisode suivant. Limite arrête la lecture automatique après ce nombre d’épisodes d’affilée."
          }
        }
      }
    },
