          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier « %1$@ » et tout son contenu seront supprimés de %2$@. Cette action est irréversible."
          }
        }
      }
    },
    "The guide doesn't identify this programme well enough to record it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Programmdaten beschreiben diese Sendung nicht genau genug, um sie aufzunehmen."
