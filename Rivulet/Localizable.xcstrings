    },
    "Sign in to your Jellyfin server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich bei deinem Jellyfin-Server an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέσου στον διακομιστή Jellyfin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à votre serveur Jellyfin."
          }
        }
      }
    },
    "Sign in with the server, username and password from your IPTV provider (an Xtream Codes login). Rivulet loads the channels and guide." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit Server, Benutzername und Passwort deines IPTV-Anbieters an (ein Login für Xtream Codes). Rivulet lädt die Sender und das Programm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέσου με διακομιστή, όνομα χρήστη και κωδικό του παρόχου IPTV (Xtream Codes). Το Rivulet φορτώνει κανάλια και οδηγό."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec le serveur, l’identifiant et le mot de passe de votre fournisseur IPTV (compte Xtream Codes). Rivulet charge chaînes et guide."
          }
        }
      }
    },
    "Sign in without typing a password: Rivulet shows a code to approve from a device already signed in to Jellyfin. Quick Connect has to be on in the server's dashboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmelden ohne Passwort: Rivulet zeigt einen Code, den du auf einem bei Jellyfin angemeldeten Gerät bestätigst. Quick Connect muss im Server-Dashboard aktiv sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέσου χωρίς πληκτρολόγηση κωδικού: το Rivulet εμφανίζει έναν κωδικό έγκρισης από ήδη συνδεδεμένη συσκευή Jellyfin. Η «Γρήγορη σύνδεση» πρέπει να είναι ενεργή στον διακομιστή."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connexion sans mot de passe : Rivulet affiche un code à approuver depuis un appareil connecté à Jellyfin. Quick Connect doit être activé sur le serveur."
          }
        }
      }
    },
    "Sign out of this %@ server and remove its saved credentials." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet dich von diesem %@-Server ab und entfernt seine gespeicherten Zugangsdaten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnecte ce serveur %@ et supprime ses identifiants enregistrés."
          }
        }
      }
    },
    "Sign out of this Jellyfin server and remove its saved credentials." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet dich von diesem Jellyfin-Server ab und entfernt seine gespeicherten Zugangsdaten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποσύνδεση από αυτόν τον διακομιστή Jellyfin και διαγραφή των αποθηκευμένων διαπιστευτηρίων."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnecte ce serveur Jellyfin et supprime ses identifiants enregistrés."
          }
        }
      }
    },
    "Sign out of your Plex account. Every Plex server on it leaves Rivulet until you sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet dich von deinem Plex-Account ab. Alle Plex-Server darin verschwinden aus Rivulet, bis du dich wieder anmeldest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποσύνδεση από τον λογαριασμό Plex. Όλοι οι διακομιστές Plex αφαιρούνται από το Rivulet μέχρι να συνδεθείς ξανά."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnecte votre compte Plex. Tous ses serveurs quittent Rivulet jusqu’à la prochaine connexion."
          }
        }
      }
    },
    "Signed in as %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet als %@"
          }
        },
        "el" : {
