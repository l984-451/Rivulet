    "Foreign Audio" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Fremdsprache"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
