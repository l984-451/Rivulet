    "Only needed if your server asks for a login, and to record. Leave both empty to just watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur nötig, wenn dein Server eine Anmeldung verlangt, und zum Aufnehmen. Lass beide Felder leer, um nur fernzusehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαιτείται μόνο αν ο διακομιστής ζητά σύνδεση ή για εγγραφή προγραμμάτων. Αφήστε και τα δύο κενά για απλή παρακολούθηση."
          }
        }
      }
    },
    "Only needed to record. Leave both empty to just watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur zum Aufnehmen nötig. Lass beide Felder leer, um nur fernzusehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαιτείται μόνο για εγγραφή. Αφήστε και τα δύο κενά για απλή παρακολούθηση."
          }
        }
      }
    },
    "Only Plex converts. Jellyfin and Emby always download the original file." : {
      "localizations" : {
        "de" : {
