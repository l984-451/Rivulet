    "Dispatcharr didn't accept that username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispatcharr hat Benutzername und Passwort nicht akzeptiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Dispatcharr δεν δέχτηκε το όνομα χρήστη και τον κωδικό πρόσβασης."
          }
        }
      }
    },
    "Dispatcharr doesn't list this channel, so it can't record it. Refresh the channel list and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispatcharr führt diesen Sender nicht und kann ihn daher nicht aufnehmen. Aktualisiere die Senderliste und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Dispatcharr δεν έχει αυτό το κανάλι και δεν μπορεί να το εγγράψει. Ανανέωσε τη λίστα καναλιών και δοκίμασε ξανά."
          }
        }
      }
    },
    "Dispatcharr endpoint not found - verify URL" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispatcharr-Endpunkt nicht gefunden: Prüfe die URL"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκε το σημείο σύνδεσης του Dispatcharr — ελέγξτε τη διεύθυνση URL"
          }
        }
      }
    },
    "Dispatcharr only. Sign in with your Dispatcharr user so Rivulet can schedule recordings and series from the guide. Leave it empty to just watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für Dispatcharr. Melde dich mit deinem Dispatcharr-Benutzer an, damit Rivulet Aufnahmen und Serien aus dem Programm planen kann. Lass das Feld leer, wenn du nur fernsehen möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο για Dispatcharr. Συνδέσου με τον χρήστη Dispatcharr ώστε το Rivulet να προγραμματίζει εγγραφές και σειρές από τον οδηγό. Άφησέ το κενό μόνο για παρακολούθηση."
          }
        }
      }
    },
    "Dispatcharr only. The name of a channel profile, to load just that set of channels. Leave it empty and you get every channel on the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für Dispatcharr. Der Name eines Senderprofils, um nur diese Sender zu laden. Lässt du das Feld leer, erhältst du alle Sender des Servers."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο για Dispatcharr. Το όνομα ενός προφίλ καναλιών για φόρτωση μόνο αυτής της ομάδας. Άφησέ το κενό για όλα τα κανάλια."
          }
        }
      }
    },
