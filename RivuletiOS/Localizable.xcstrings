    "\"%@\" is shared through iCloud. Remove it from this device only, or from every device?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird über iCloud geteilt. Nur von diesem Gerät entfernen oder von allen Geräten?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est partagé via iCloud. Le supprimer de cet appareil seulement, ou de tous les appareils ?"
          }
        }
      }
    },
    "All Devices" : {
