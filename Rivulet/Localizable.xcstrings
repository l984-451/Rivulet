          "stringUnit" : {
            "state" : "translated",
            "value" : "Durée d’affichage de chaque photo pendant un diaporama."
          }
        }
      }
    },
    "How long to wait before automatically playing the next episode. Set to Off to disable autoplay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie lange gewartet wird, bevor die nächste Folge automatisch startet. Wähle „Aus“, um die automatische Wiedergabe zu deaktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πόση ώρα περιμένει πριν παίξει αυτόματα το επόμενο επεισόδιο. Επίλεξε «Ανενεργό» για απενεργοποίηση."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai avant l’épisode suivant automatique. Désactivé coupe la lecture automatique."
          }
        }
      }
    },
    "How many more episodes play on their own after the one you picked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele weitere Folgen nach der gewählten von selbst laufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre d’épisodes lus seuls après celui que vous avez choisi."
          }
        }
      }
    },
    "How this source appears in Live TV. Leave it empty to use “%@”." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie diese Quelle in Live-TV angezeigt wird. Lass das Feld leer, um „%@“ zu verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πώς θα εμφανίζεται αυτή η πηγή στη ζωντανή τηλεόραση. Αφήστε το κενό για να χρησιμοποιηθεί το «%@»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nom de cette source dans TV en direct. Laissez vide pour utiliser « %@ »."
          }
        }
      }
    },
    "IMDb users" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IMDb-Nutzer:innen"
          }
