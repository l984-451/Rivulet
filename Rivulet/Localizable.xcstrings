    "English only for now. With Subtitles set to Always, a title with no subtitles in your language gets them written from its dialogue. Downloads 230 MB." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derzeit nur Englisch. Wenn „Untertitel“ auf „Immer“ steht, werden für Titel ohne Untertitel in deiner Sprache welche aus den Dialogen erstellt. Download: 230 MB."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προς το παρόν υποστηρίζονται μόνο αγγλικά. Με τους υπότιτλους στη ρύθμιση «Πάντα», δημιουργούνται υπότιτλοι από τους διαλόγους όταν δεν υπάρχουν στη γλώσσα σας. Απαιτείται λήψη 230 MB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anglais uniquement pour l’instant. Avec Sous-titres sur Toujours, un titre sans sous-titres dans votre langue en reçoit, tirés de ses dialogues. Téléchargement de 230 Mo."
          }
        }
      }
    },
