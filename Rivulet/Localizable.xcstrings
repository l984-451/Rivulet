    },
    "This server can't stream this title to Apple TV." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server kann diesen Titel nicht an das Apple TV streamen."
          }
        }
      }
    },
    "This server runs Jellyfin %@. Rivulet needs %lld.%lld or newer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Server läuft Jellyfin %@. Rivulet benötigt %lld.%lld oder neuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This server runs Jellyfin %1$@. Rivulet needs %2$lld.%3$lld or newer."
          }
        }
      }
    },
    "This server's HTTPS certificate isn't trusted. Try its http:// address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
