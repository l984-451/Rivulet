    "What's New" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuigkeiten"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι νέο υπάρχει"
          }
        }
      }
    },
    "What's On" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt im TV"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι παίζει τώρα"
          }
        }
      }
    },
    "When a recap starts. Manual shows Skip Recap, Automatic skips it, Off shows nothing. Recap markers come from the community database below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Rückblick beginnt. „Manuell“ zeigt „Rückblick überspringen“, „Automatisch“ überspringt ihn, „Aus“ zeigt nichts an. Die Rückblick-Markierungen stammen aus der Community-Datenbank unten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στην αρχή ανακεφαλαίωσης. «Χειροκίνητο» εμφανίζει «Παράλειψη ανακεφαλαίωσης», «Αυτόματο» την παραλείπει και «Ανενεργό» δεν εμφανίζει τίποτα. Οι δείκτες προέρχονται από την κοινοτική βάση παρακάτω."
          }
        }
      }
    },
    "When off, closing credits play uninterrupted and the player returns to Home at the end of the episode." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Option deaktiviert ist, läuft der Abspann ohne Unterbrechung und der Player kehrt am Ende der Folge zur Startseite zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανενεργό, οι τίτλοι τέλους παίζουν χωρίς διακοπή και μετά το επεισόδιο επιστρέφει στην Αρχική."
          }
        }
      }
    },
    "When you go back from a live channel, it keeps playing with its sound in the corner of the Guide or What's On. Select it again to return to full screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Live-Sender verlässt, läuft er mit Ton in der Ecke des Programms oder von „Jetzt im TV“ weiter. Wähle ihn erneut aus, um zum Vollbild zurückzukehren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν επιστρέφεις από ζωντανό κανάλι, συνεχίζει να παίζει με ήχο στη γωνία του Οδηγού ή του «Τι παίζει». Επίλεξέ το ξανά για πλήρη οθόνη."
          }
        }
      }
    },
    "When you watch" : {
