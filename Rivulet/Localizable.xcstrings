      }
    },
    "your Plex server" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "deinem Plex-Server"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ο διακομιστής Plex σου"
          }
        }
      }
    },
    "Your Plex server is taking too long to prepare the video. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Plex-Server braucht zu lange, um das Video vorzubereiten. Versuche es erneut."
          }
        },
        "el" : {
