          }
        }
      }
    },
    "If your provider gave you a guide link (XMLTV), enter it. Otherwise leave this empty: Rivulet uses the guide the playlist names, if it has one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dir dein Anbieter einen Programm-Link (XMLTV) gegeben hat, gib ihn ein. Andernfalls lass das Feld leer: Rivulet verwendet dann das Programm, das in der Playlist angegeben ist, falls vorhanden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ο πάροχος έδωσε σύνδεσμο οδηγού XMLTV, πληκτρολόγησέ τον. Διαφορετικά, άφησέ τον κενό: το Rivulet χρησιμοποιεί τον οδηγό που ορίζει η λίστα, αν υπάρχει."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si votre fournisseur vous a donné un lien de guide (XMLTV), saisissez-le. Sinon, laissez vide : Rivulet utilise le guide indiqué par la playlist, s’il y en a un."
          }
        }
      }
    },
    "In %lld you watched" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
