    "That address doesn't look right. Check it and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse scheint nicht zu stimmen. Prüfe sie und versuche es erneut."
          }
        }
      }
    },
    "That address isn't a Tvheadend server. Check the address and port." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse läuft kein Tvheadend-Server. Prüfe Adresse und Port."
          }
        }
      }
    },
    "That address isn't an Xtream Codes server. Check the address and port." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse läuft kein Xtream-Codes-Server. Prüfe Adresse und Port."
          }
        }
      }
    },
    "That playlist URL doesn't look right. Check it and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Playlist-URL scheint nicht zu stimmen. Prüfe sie und versuche es erneut."
          }
        }
      }
    },
    "That server has no Dispatcharr sign-in. Clear the username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server hat keine Dispatcharr-Anmeldung. Lass Benutzername und Passwort leer."
          }
        }
      }
    },
    "That server refused Rivulet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat Rivulet abgewiesen."
          }
        }
      }
    },
    "The M3U link from your provider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der M3U-Link deines Anbieters."
          }
        }
      }
    },
    "The download is too large." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download ist zu groß."
          }
        }
      }
    },
    "The download was cut short" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download wurde abgebrochen"
          }
        }
      }
    },
    "The downloaded file didn't match the server's copy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die heruntergeladene Datei stimmt nicht mit der Kopie auf dem Server überein"
          }
        }
      }
    },
    "The file is no longer on the server" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei ist nicht mehr auf dem Server"
          }
        }
      }
    },
    "The guide doesn't identify this programme well enough to record it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Programmdaten beschreiben diese Sendung nicht genau genug, um sie aufzunehmen."
          }
        }
      }
    },
    "The guide is too large" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Programmdaten sind zu groß"
          }
        }
      }
    },
    "The server" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server"
          }
        }
      }
    },
    "The server address from your provider, with its port. You can also paste a get.php link: Rivulet fills in the username and password from it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serveradresse deines Anbieters mit Port. Du kannst auch einen get.php-Link einfügen: Rivulet übernimmt daraus Benutzername und Passwort."
          }
        }
      }
    },
    "The server couldn't convert this item" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server konnte dieses Objekt nicht konvertieren"
          }
        }
      }
    },
    "The server didn't accept that username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat Benutzername und Passwort nicht akzeptiert."
          }
        }
      }
    },
    "The server is refusing new streams right now. Wait a moment and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server nimmt gerade keine neuen Streams an. Warte einen Moment und versuche es erneut."
          }
        }
      }
    },
    "The server no longer has this conversion" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat diese Konvertierung nicht mehr"
          }
        }
      }
    },
    "The server offered no way to record this programme." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server bietet keine Möglichkeit, diese Sendung aufzunehmen."
          }
        }
      }
    },
    "The server refused the download (HTTP %lld)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat den Download abgelehnt (HTTP %lld)"
          }
        }
      }
    },
    "The server refused this stream. It may have moved, or your access to it may have changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat diesen Stream abgelehnt. Vielleicht wurde er verschoben oder dein Zugriff hat sich geändert."
          }
        }
      }
    },
    "The server said: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwort des Servers: %@"
          }
        }
      }
    },
    "The server sent a response Rivulet couldn't read" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat eine Antwort gesendet, die Rivulet nicht lesen konnte"
          }
        }
      }
    },
    "The server's security certificate was not accepted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sicherheitszertifikat des Servers wurde nicht akzeptiert."
          }
        }
      }
    },
    "These also set how far a double tap jumps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Werte legen auch fest, wie weit ein Doppeltippen springt."
          }
        }
      }
    },
    "This Dolby Vision file has no fallback layer this device can decode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Dolby-Vision-Datei hat keine Ersatzebene, die dieses Gerät decodieren kann."
          }
        }
      }
    },
    "This Tvheadend server needs a username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tvheadend-Server benötigt Benutzername und Passwort."
          }
        }
      }
    },
    "This Tvheadend user can't record." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tvheadend-Benutzer darf nicht aufnehmen."
          }
        }
      }
    },
