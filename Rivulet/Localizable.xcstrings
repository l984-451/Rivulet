    "Mute language and skip scenes during playback without changing the file. Language comes from English subtitles; skips from a filter list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet Ausdrücke stumm und überspringt Szenen bei der Wiedergabe, ohne die Datei zu ändern. Ausdrücke kommen aus englischen Untertiteln, Szenen aus einer Filterliste."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σίγαση λέξεων και παράλειψη σκηνών κατά την αναπαραγωγή χωρίς αλλαγή του αρχείου. Οι λέξεις προέρχονται από αγγλικούς υπότιτλους και οι σκηνές από λίστα φίλτρων."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le langage et saute des scènes sans modifier le fichier. Langage : sous-titres anglais ; sauts : liste de filtres."
          }
        }
      }
    },
    "Mutes crude and sexual language in the dialogue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet derbe und sexuelle Ausdrücke im Dialog stumm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σιγάζει αγενείς και σεξουαλικές εκφράσεις στους διαλόγους."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe le langage grossier et sexuel."
          }
        }
      }
    },
    "Mutes swearing at the strength you pick. Also applies to imported filter lists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet Schimpfwörter in der gewählten Stärke stumm. Gilt auch für importierte Filterlisten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe les jurons selon l’intensité choisie, listes importées incluses."
          }
        }
      }
    },
    "Mutes racial, homophobic and other slurs in the dialogue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet rassistische, homophobe und andere abwertende Beleidigungen im Dialog stumm."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σιγάζει ρατσιστικές, ομοφοβικές και άλλες προσβλητικές εκφράσεις στους διαλόγους."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe les insultes racistes, homophobes et autres."
          }
        }
      }
    },
    "Mutes religious names used as exclamations, such as \"oh my god\". The word god on its own is never muted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet religiöse Namen stumm, die als Ausruf verwendet werden, etwa „oh my god“. Das Wort „god“ allein wird nie stummgeschaltet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σιγάζει θρησκευτικές εκφράσεις που χρησιμοποιούνται ως επιφωνήματα, όπως «ω Θεέ μου». Η λέξη «Θεός» μόνη της δεν σιγάζεται."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe les noms religieux en exclamation, comme « oh my god ». Le mot « god » seul n’est jamais coupé."
          }
        }
      }
    },
