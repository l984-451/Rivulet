    "Rivulet can't connect to %@. Check that the server is running and your network is connected. Recently loaded content is still available to browse." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivulet kann keine Verbindung zu %@ herstellen. Prüfe, ob der Server läuft und dein Netzwerk verbunden ist. Zuletzt geladene Inhalte kannst du weiterhin durchstöbern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Rivulet δεν συνδέεται στο %@. Βεβαιώσου ότι ο διακομιστής λειτουργεί και το δίκτυο είναι συνδεδεμένο. Μπορείς ακόμη να περιηγηθείς στο πρόσφατα φορτωμένο περιεχόμενο."
          }
        }
      }
    },
    "Rivulet needs %@ Server %lld.%lld.%lld or newer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivulet benötigt %1$@-Server %2$lld.%3$lld.%4$lld oder neuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rivulet needs %1$@ Server %2$lld.%3$lld.%4$lld or newer."
          }
        }
      }
    },
    "Rivulet's license and the open-source software it uses, including FFmpeg (LGPL), libdovi, and Sentry." : {
      "localizations" : {
