    "For You" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dich"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για εσάς"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vous"
          }
        }
      }
    },
    "For You picks channels from what you watch. It learns on this device only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Für dich“ wählt Sender danach aus, was du ansiehst. Es lernt nur auf diesem Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ενότητα «Για εσένα» επιλέγει κανάλια με βάση όσα παρακολουθείς. Μαθαίνει μόνο σε αυτή τη συσκευή."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour vous propose des chaînes d’après ce que vous regardez. Il apprend sur cet appareil uniquement."
          }
        }
      }
    },
    "Forced" : {
      "localizations" : {
