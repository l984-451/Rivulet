    "Your code is %@. Include it in your GitHub issue or message so the report can be found." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Code lautet %@. Gib ihn in deinem GitHub-Issue oder deiner Nachricht an, damit der Bericht gefunden werden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός σου είναι %@. Συμπερίλαβέ τον στο ζήτημα GitHub ή στο μήνυμά σου, ώστε να εντοπιστεί η αναφορά."
          }
        }
      }
    },
    "Your Dispatcharr password. Only needed to record; leave it empty to just watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Dispatcharr-Passwort. Nur zum Aufnehmen nötig. Lass das Feld leer, wenn du nur schauen willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός Dispatcharr. Χρειάζεται μόνο για εγγραφές· άφησέ τον κενό για απλή παρακολούθηση."
          }
        }
      }
    },
    "Your Dispatcharr server. Rivulet loads its channels and guide, and records through it if you sign in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Dispatcharr-Server. Rivulet lädt seine Sender und sein Programm und nimmt darüber auf, wenn du dich anmeldest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής Dispatcharr. Το Rivulet φορτώνει κανάλια και οδηγό και, αν συνδεθείς, πραγματοποιεί εγγραφές."
          }
        }
      }
    },
    "Your Dispatcharr server's address on your network, with its port. Dispatcharr uses 9191 unless you changed it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse deines Dispatcharr-Servers in deinem Netzwerk, mit Port. Dispatcharr verwendet Port 9191, sofern du ihn nicht geändert hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διεύθυνση του Dispatcharr στο δίκτυό σου, με θύρα. Η προεπιλεγμένη θύρα είναι 9191."
          }
        }
      }
    },
    "Your Dispatcharr username. Only needed to record; leave it empty to just watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Dispatcharr-Benutzername. Nur zum Aufnehmen nötig. Lass das Feld leer, wenn du nur schauen willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το όνομα χρήστη Dispatcharr. Χρειάζεται μόνο για εγγραφές· άφησέ το κενό για απλή παρακολούθηση."
          }
        }
      }
    },
    "Your Emby sign-in is shared through iCloud. Sign out of this device only, or of every device?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
