    "Your server couldn't prepare this video for playback. It may be busy with other streams." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server konnte dieses Video nicht für die Wiedergabe vorbereiten. Vielleicht ist er mit anderen Streams ausgelastet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής δεν μπόρεσε να προετοιμάσει αυτό το βίντεο. Ίσως είναι απασχολημένος με άλλες ροές."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur n’a pas pu préparer cette vidéo pour la lecture. Il est peut-être occupé par d’autres flux."
          }
        }
      }
    },
    "Your server is refusing new streams right now. Wait a moment and try again." : {
      "localizations" : {
        "de" : {
