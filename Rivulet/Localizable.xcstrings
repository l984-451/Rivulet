    "After this many episodes play in a row, the next one waits for you instead of starting on its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn so viele Folgen nacheinander gelaufen sind, wartet die nächste auf dich, statt von selbst zu starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετά από τόσα συνεχόμενα επεισόδια, το επόμενο θα περιμένει την εντολή σου αντί να ξεκινήσει αυτόματα."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après ce nombre d’épisodes d’affilée, le suivant attend votre feu vert au lieu de démarrer seul."
          }
        }
      }
    },
