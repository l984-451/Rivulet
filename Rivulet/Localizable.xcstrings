        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le filtre ne masquera plus ce mot."
          }
        }
      }
    },
    "The folder “%@” and everything in it will be deleted from %@. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner „%1$@“ und alles darin wird von %2$@ gelöscht. Dieser Vorgang kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
