    "Skips frightening or intense scenes. Requires an imported filter list — set the Filter List URL below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt beängstigende oder intensive Szenen. Erfordert eine importierte Filterliste: Lege unten die „Filterlisten-URL“ fest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραλείπει τρομακτικές ή έντονες σκηνές. Απαιτεί εισαγόμενη λίστα φίλτρων· όρισέ την παρακάτω."
          }
        }
      }
    },
    "Skips scenes featuring drug, alcohol, or tobacco use. Requires an imported filter list — set the Filter List URL below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt Szenen mit Drogen-, Alkohol- oder Tabakkonsum. Erfordert eine importierte Filterliste: Lege unten die „Filterlisten-URL“ fest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραλείπει σκηνές με χρήση ναρκωτικών, αλκοόλ ή καπνού. Απαιτεί εισαγόμενη λίστα φίλτρων· όρισέ την παρακάτω."
          }
        }
      }
    },
    "Skips scenes with sex or nudity. Requires an imported filter list — set the Filter List URL below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt Szenen mit Sex oder Nacktheit. Erfordert eine importierte Filterliste: Lege unten die „Filterlisten-URL“ fest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραλείπει σκηνές σεξ ή γυμνού. Απαιτεί εισαγόμενη λίστα φίλτρων· όρισέ την παρακάτω."
          }
        }
      }
    },
    "Skips violent and gory scenes. Requires an imported filter list — set the Filter List URL below. Dialogue text alone can't detect these scenes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringt gewalttätige und blutige Szenen. Erfordert eine importierte Filterliste: Lege unten die „Filterlisten-URL“ fest. Am Dialogtext allein lassen sich diese Szenen nicht erkennen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραλείπει σκηνές βίας ή αίματος. Απαιτεί εισαγόμενη λίστα φίλτρων· όρισέ την παρακάτω. Μόνο από το κείμενο διαλόγου δεν εντοπίζονται."
          }
        }
      }
    },
