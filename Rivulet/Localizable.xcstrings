    "That address doesn't look right. Check it and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse scheint nicht zu stimmen. Prüfe sie und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η διεύθυνση δεν φαίνεται σωστή. Έλεγξέ την και δοκίμασε ξανά."
          }
        }
      }
    },
    "That address isn't a Jellyfin server. Check the port. An Emby server signs in under Emby Server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse läuft kein Jellyfin-Server. Prüfe den Port. Ein Emby-Server wird unter „Emby-Server“ angemeldet."
          }
        }
      }
    },
    "That address isn't a Tvheadend server. Check the address and port." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse läuft kein Tvheadend-Server. Prüfe Adresse und Port."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η διεύθυνση δεν αντιστοιχεί σε διακομιστή Tvheadend. Έλεγξε διεύθυνση και θύρα."
          }
        }
      }
    },
    "That address isn't an %@ server. Check the port. A Jellyfin server signs in under Jellyfin Server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse läuft kein %@-Server. Prüfe den Port. Ein Jellyfin-Server wird unter „Jellyfin-Server“ angemeldet."
          }
        }
      }
    },
    "That address isn't an Xtream Codes server. Check the address and port." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter dieser Adresse läuft kein Xtream-Codes-Server. Prüfe Adresse und Port."
          }
        },
        "el" : {
