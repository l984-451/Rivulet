    "Only needed if your server asks for a login, and to record. Leave both empty to just watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur nötig, wenn dein Server eine Anmeldung verlangt, und zum Aufnehmen. Lass beide Felder leer, um nur fernzusehen."
          }
        }
      }
    },
    "Optional" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional"
          }
        }
      }
    },
    "Optional. A folder or address with per-title MCF or EDL filter files. From moviecontentfilter.com, download the EDL with your copy's times." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Ein Ordner oder eine Adresse mit MCF- oder EDL-Filterdateien pro Titel. Lade bei moviecontentfilter.com die EDL mit den Zeiten deiner Fassung herunter."
          }
        }
      }
    },
    "Optional. An XMLTV guide link from the same provider, so channels show what is on. Leave it empty if the playlist names its own guide." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Ein XMLTV-Programmlink desselben Anbieters, damit die Sender anzeigen, was läuft. Lass das Feld leer, wenn die Playlist ihr eigenes Programm angibt."
          }
        }
      }
    },
    "Original" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Original"
          }
        }
      }
    },
    "Original Audio" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Originalaudio"
          }
        }
      }
    },
    "Original plays the file as is. Auto converts only when your connection needs it. A fixed rate converts anything above it, dropping HDR and Atmos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Original“ gibt die Datei unverändert wieder. „Automatisch“ konvertiert nur, wenn deine Verbindung es erfordert. Eine feste Rate konvertiert alles darüber, wobei HDR und Atmos verloren gehen."
          }
        }
      }
    },
