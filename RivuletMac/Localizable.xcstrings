          }
        }
      }
    },
    "Choose what the hero shows. Pick more than one to mix them. Turn all off to hide the hero." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, was der Hero zeigt. Mehrere Quellen werden gemischt. Schalte alle aus, um den Hero auszublenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε τι δείχνει το Hero. Επιλέξτε περισσότερα για ανάμειξη. Απενεργοποιήστε όλα για να κρυφτεί."
          }
        }
      }
    },
    "Choose…" : {
      "localizations" : {
        "de" : {
