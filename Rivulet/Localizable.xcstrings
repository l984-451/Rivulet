        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur a refusé le téléchargement (HTTP %lld)"
          }
        }
      }
    },
    "The server said: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwort des Servers: %@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μήνυμα διακομιστή: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponse du serveur : %@"
          }
        }
      }
    },
    "The stream couldn't be loaded. Check that your server is running and reachable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Stream konnte nicht geladen werden. Prüfe, ob dein Server läuft und erreichbar ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν φορτώθηκε η ροή. Έλεγξε ότι ο διακομιστής λειτουργεί και είναι προσβάσιμος."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger le flux. Vérifiez que votre serveur est en marche et joignable."
          }
        }
      }
    },
    "The stream from your server couldn't be played. The server may still be preparing the video." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Stream deines Servers konnte nicht wiedergegeben werden. Vielleicht bereitet der Server das Video noch vor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η αναπαραγωγή της ροής από τον διακομιστή. Ίσως ακόμη προετοιμάζει το βίντεο."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire le flux de votre serveur. Il prépare peut-être encore la vidéo."
          }
        }
      }
    },
    "The top row of the Apple TV Home Screen. Posters shows a row of posters. Full Screen fills it with artwork from what you are watching." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die oberste Reihe auf dem Home-Bildschirm des Apple TV. „Poster“ zeigt eine Reihe von Postern. „Vollbild“ füllt sie mit Bildern von dem, was du gerade ansiehst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επάνω σειρά στην αρχική οθόνη του Apple TV. «Αφίσες» δείχνει μια σειρά αφισών. «Πλήρης οθόνη» γεμίζει την περιοχή με εικόνες από όσα βλέπεις."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangée du haut de l’écran d’accueil de l’Apple TV. Affiches : une rangée d’affiches. Plein écran : visuels de ce que vous regardez."
          }
        }
      }
    },
    "The username your provider gave you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Benutzername, den du von deinem Anbieter erhalten hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το όνομα χρήστη που σου έδωσε ο πάροχος."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiant fourni par votre fournisseur."
          }
        }
      }
    },
    "This Dolby Vision file has no fallback layer this Apple TV can decode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Dolby-Vision-Datei hat keine Ersatzebene, die dieses Apple TV decodieren kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αρχείο Dolby Vision δεν έχει εναλλακτικό επίπεδο που να μπορεί να αποκωδικοποιήσει το Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier Dolby Vision n’a pas de couche de secours que cette Apple TV peut décoder."
          }
        }
      }
    },
    "This Tvheadend server needs a username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tvheadend-Server benötigt Benutzername und Passwort."
          }
        },
        "el" : {
          "stringUnit" : {
