      }
    },
    "The server doesn't have that." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat das nicht."
          }
        }
      }
    },
    "The server is refusing new streams right now. Wait a moment and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server nimmt gerade keine neuen Streams an. Warte einen Moment und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής απορρίπτει προς το παρόν νέες ροές. Περίμενε λίγο και δοκίμασε ξανά."
          }
        }
      }
    },
    "The server no longer has this conversion" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat diese Konvertierung nicht mehr"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η μετατροπή δεν υπάρχει πλέον στον διακομιστή"
          }
        }
      }
    },
    "The server offered no way to record this programme." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server bietet keine Möglichkeit, diese Sendung aufzunehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής δεν προσέφερε τρόπο εγγραφής αυτού του προγράμματος."
          }
        }
      }
    },
    "The server refused the download (HTTP %lld)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat den Download abgelehnt (HTTP %lld)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής απέρριψε τη λήψη (HTTP %lld)"
          }
        }
      }
    },
    "The server refused this stream. It may have moved, or your access to it may have changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat diesen Stream abgelehnt. Vielleicht wurde er verschoben oder dein Zugriff hat sich geändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής απέρριψε αυτή τη ροή. Ίσως μετακινήθηκε ή άλλαξαν τα δικαιώματά σου."
          }
        }
      }
    },
    "The server said: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antwort des Servers: %@"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μήνυμα διακομιστή: %@"
          }
        }
      }
    },
    "The server's security certificate was not accepted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sicherheitszertifikat des Servers wurde nicht akzeptiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το πιστοποιητικό ασφαλείας του διακομιστή δεν έγινε αποδεκτό."
          }
        }
      }
    },
    "These set how far the skip buttons jump." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie legen fest, wie weit die Sprungtasten springen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίζουν πόσο πηδούν τα κουμπιά παράλειψης."
          }
        }
      }
    },
    "This Device Only" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur dieses Gerät"
          }
        }
      }
    },
    "This Dolby Vision file has no fallback layer this device can decode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Dolby-Vision-Datei hat keine Ersatzebene, die dieses Gerät decodieren kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αρχείο Dolby Vision δεν έχει εναλλακτικό επίπεδο που να μπορεί να αποκωδικοποιήσει η συσκευή."
          }
        }
      }
    },
    "This Tvheadend server needs a username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tvheadend-Server benötigt Benutzername und Passwort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο διακομιστής Tvheadend χρειάζεται όνομα χρήστη και κωδικό."
          }
        }
      }
    },
    "This Tvheadend user can't record." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tvheadend-Benutzer darf nicht aufnehmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο χρήστης Tvheadend δεν έχει δικαίωμα εγγραφής."
          }
        }
      }
    },
    "This account has expired. Contact your provider to renew it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Account ist abgelaufen. Wende dich an deinen Anbieter, um ihn zu verlängern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο λογαριασμός έληξε. Επικοινώνησε με τον πάροχό σου για ανανέωση."
          }
        }
      }
    },
    "This account is turned off. Contact your provider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Account ist deaktiviert. Wende dich an deinen Anbieter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο λογαριασμός είναι απενεργοποιημένος. Επικοινώνησε με τον πάροχό σου."
          }
        }
      }
    },
    "This account isn't allowed to download from the server" : {
