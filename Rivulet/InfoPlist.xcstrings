      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivulet stellt eine Verbindung zu Medienservern in deinem lokalen Netzwerk her, etwa zu deinem Plex-Server, um deine Mediathek zu streamen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Rivulet συνδέεται με διακομιστές πολυμέσων στο τοπικό σας δίκτυο, όπως τον διακομιστή Plex, για να αναπαράγει τη βιβλιοθήκη σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rivulet connects to media servers on your local network, such as your Plex server, to stream your library."
          }
        }
      }
