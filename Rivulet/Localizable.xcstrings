        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής σου απορρίπτει προς το παρόν νέες ροές. Περίμενε λίγο και δοκίμασε ξανά."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur refuse de nouveaux flux pour le moment. Patientez un instant et réessayez."
