          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a proposé aucun moyen d’enregistrer ce programme."
          }
        }
      }
    },
    "The server refused the download (HTTP %lld)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat den Download abgelehnt (HTTP %lld)"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής απέρριψε τη λήψη (HTTP %lld)"
