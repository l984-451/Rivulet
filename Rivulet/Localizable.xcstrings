    "The files will be deleted from %@. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Dateien werden von %@ gelöscht. Dieser Vorgang kann nicht widerrufen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αρχεία θα διαγραφούν από το %@. Η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers seront supprimés de %@. Cette action est irréversible."
          }
        }
      }
    },
    "The filter will stop muting this word." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Filter schaltet dieses Wort nicht mehr stumm."
