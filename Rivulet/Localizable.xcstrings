    "Mute language and skip scenes during playback without changing the file. Language comes from English subtitles; skips from a filter list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte Ausdrücke stumm und überspringe Szenen bei der Wiedergabe, ohne die Datei zu ändern. Ausdrücke werden anhand englischer Untertitel erkannt, Szenen anhand einer Filterliste übersprungen."
          }
        }
      }
    },
    "Mutes crude and sexual language in the dialogue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet derbe und sexuelle Ausdrücke im Dialog stumm."
          }
        }
      }
    },
    "Mutes profane words: mild and up, moderate and up, or strong only. Also applies to profanity in imported filter lists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet Schimpfwörter stumm: ab leicht, ab mittel oder nur stark. Gilt auch für Schimpfwörter in importierten Filterlisten."
          }
        }
      }
    },
    "Mutes racial, homophobic and other slurs in the dialogue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet rassistische, homophobe und andere abwertende Beleidigungen im Dialog stumm."
          }
        }
      }
    },
    "Mutes religious names used as exclamations, such as \"oh my god\". The word god on its own is never muted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet religiöse Namen stumm, die als Ausruf verwendet werden, etwa „oh my god“. Das Wort „god“ allein wird nie stummgeschaltet."
          }
        }
      }
    },
