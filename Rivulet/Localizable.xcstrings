        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται μία φορά για σύνδεση. Το Rivulet αποθηκεύει το token πρόσβασης του Jellyfin και όχι τον κωδικό."
          }
        }
