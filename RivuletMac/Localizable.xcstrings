    "This removes the playlist from your server. The titles stay in your library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird die Playlist von deinem Server entfernt. Die Titel bleiben in deiner Mediathek."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί τη λίστα αναπαραγωγής από τον διακομιστή. Οι τίτλοι μένουν στη βιβλιοθήκη."
          }
        }
      }
    },
    "This server can't stream this title to this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server kann diesen Titel nicht auf dieses Gerät streamen."
          }
        }
      }
    },
    "This server runs Jellyfin %@. Rivulet needs %lld.%lld or newer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Server läuft Jellyfin %@. Rivulet benötigt %lld.%lld oder neuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This server runs Jellyfin %1$@. Rivulet needs %2$lld.%3$lld or newer."
          }
        }
      }
    },
    "This server's HTTPS certificate isn't trusted. Try its http:// address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
