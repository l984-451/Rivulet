    },
    "Tune failed: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuner-Fehler: %@"
          }
        }
      }
    },
    "Turn Home rows off on this Apple TV. Rows come from your Plex account; a library shows here once it is pinned to Home in Plex." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte Reihen der Startseite auf diesem Apple TV aus. Die Reihen kommen aus deinem Plex-Account. Eine Mediathek erscheint hier, sobald sie in Plex an die Startseite angepinnt ist."
          }
        }
      }
    },
    "Turn off to remove this server from Rivulet: its libraries, Home rows, Continue Watching and Live TV. Your account stays signed in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte diese Option aus, um diesen Server aus Rivulet zu entfernen: seine Mediatheken, Reihen der Startseite, „Weiter ansehen“ und Live-TV. Dein Account bleibt angemeldet."
          }
        }
      }
    },
    "Turn on another server first, or sign out of Plex." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte zuerst einen anderen Server ein oder melde dich von Plex ab."
          }
        }
      }
    },
    "Turn this row off to hide it on this Apple TV. Your Plex account is unchanged, so the row keeps showing in the Plex app and on your other devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte diese Reihe aus, um sie auf diesem Apple TV auszublenden. Dein Plex-Account bleibt unverändert, die Reihe erscheint also weiterhin in der Plex-App und auf deinen anderen Geräten."
          }
        }
      }
    },
    "Turns the content filter on, muting and skipping by the categories below. A player button pauses it for the current title." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet den Inhaltsfilter ein, der nach den Kategorien unten stummschaltet und überspringt. Mit einer Taste im Player pausierst du ihn für den aktuellen Titel."
          }
        }
      }
    },
    "Tvheadend" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend"
          }
        }
      }
    },
    "Tvheadend didn't accept that username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend hat Benutzername und Passwort nicht akzeptiert."
          }
        }
      }
    },
    "Tvheadend didn't give Rivulet a stream for this user. Check its streaming rights, or update Tvheadend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend hat Rivulet für diesen Benutzer keinen Stream geliefert. Prüfe seine Streaming-Rechte oder aktualisiere Tvheadend."
          }
        }
      }
    },
    "Tvheadend refused this user. Check its password and rights in Tvheadend." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvheadend hat diesen Benutzer abgewiesen. Prüfe sein Passwort und seine Rechte in Tvheadend."
          }
        }
      }
    },
    "Type a word or a short phrase to mute. Capitals and punctuation don't matter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ein Wort oder einen kurzen Ausdruck ein, der stummgeschaltet werden soll. Groß- und Kleinschreibung sowie Satzzeichen spielen keine Rolle."
