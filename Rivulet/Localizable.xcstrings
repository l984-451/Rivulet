        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird die Reihe aus ihrer Mediathek entfernt. Du kannst sie in ihrer Mediathek über die Sammlung wieder anpinnen."
          }
        }
