    "The server" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής"
          }
        }
      }
    },
    "The server address from your provider, with its port. You can also paste a get.php link: Rivulet fills in the username and password from it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Serveradresse deines Anbieters mit Port. Du kannst auch einen get.php-Link einfügen: Rivulet übernimmt daraus Benutzername und Passwort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διεύθυνση και η θύρα του διακομιστή του παρόχου. Μπορείς να επικολλήσεις και σύνδεσμο get.php: το Rivulet συμπληρώνει τα στοιχεία σύνδεσης από αυτόν."
          }
        }
      }
    },
    "The server couldn't convert this item" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server konnte dieses Objekt nicht konvertieren"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής δεν μπόρεσε να μετατρέψει αυτό το στοιχείο"
          }
        }
      }
    },
    "The server didn't accept that username and password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat Benutzername und Passwort nicht akzeptiert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο διακομιστής δεν δέχτηκε το όνομα χρήστη και τον κωδικό πρόσβασης."
          }
        }
      }
    },
    "The server didn't accept the sign-in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Anmeldung nicht akzeptiert."
          }
        }
      }
    },
    "The server didn't accept the sign-in; sign in again, then retry" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat die Anmeldung nicht akzeptiert; melde dich erneut an und versuche es dann noch einmal"
          }
        }
      }
    },
    "The server didn't accept your sign-in." : {
      "localizations" : {
